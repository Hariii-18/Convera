# Base URL of the FastAPI backend, including the /api/v1 prefix. In
# production, set this to the deployed backend's HTTPS URL (e.g.
# https://api.yourdomain.com/api/v1) — the WebSocket URL used for Live
# Meeting streaming is derived from this by swapping http(s) for ws(s), so
# no separate WS URL setting is needed.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
